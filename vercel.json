{
  "framework": null,
  "installCommand": "true",
  "buildCommand": "sh scripts/versao.sh",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:slug([a-z0-9][a-z0-9-]*)",
      "destination": "/api/ingresso?s=:slug"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]*)/:p([a-z0-9]{1,12})",
      "destination": "/api/ingresso?s=:slug"
    }
  ],
  "functions": {
    "api/ingresso.js": {
      "includeFiles": "public/index.html"
    }
  },
  "redirects": [
    {
      "source": "/baixar",
      "destination": "https://github.com/kellyson71/cineminha/releases/latest",
      "permanent": false
    },
    {
      "source": "/baixar/windows",
      "destination": "https://github.com/kellyson71/cineminha/releases/latest/download/Cineminha-instalador.exe",
      "permanent": false
    },
    {
      "source": "/baixar/linux",
      "destination": "https://github.com/kellyson71/cineminha/releases/latest/download/Cineminha-linux.AppImage",
      "permanent": false
    },
    {
      "source": "/baixar/arch",
      "destination": "https://github.com/kellyson71/cineminha/releases/latest/download/cineminha-linux.pacman",
      "permanent": false
    },
    {
      "source": "/baixar/deb",
      "destination": "https://github.com/kellyson71/cineminha/releases/latest/download/cineminha-linux.deb",
      "permanent": false
    },
    {
      "source": "/baixar/rpm",
      "destination": "https://github.com/kellyson71/cineminha/releases/latest/download/cineminha-linux.rpm",
      "permanent": false
    }
  ]
}
