{
  "manifest_version": 3,
  "name": "Cineminha · Netflix",
  "version": "1.2.0",
  "description": "Projeta a aba no Cineminha sem a faixa de compartilhamento, deixa a sala pausar e pular a Netflix e mostra para todos o que está passando.",
  "icons": {
    "48": "icone-48.png",
    "128": "icone-128.png"
  },
  "background": {
    "service_worker": "fundo.js"
  },
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://cineminha-boo.vercel.app/*",
    "http://localhost:8790/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://cineminha-boo.vercel.app/*",
        "http://localhost:8790/*"
      ],
      "js": [
        "ponte-cineminha.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "ponte-netflix.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "js": [
        "player-netflix.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "scripting",
    "tabCapture"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Projetar esta aba no Cineminha",
    "default_icon": {
      "48": "icone-48.png",
      "128": "icone-128.png"
    }
  }
}