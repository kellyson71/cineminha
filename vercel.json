{
  "framework": null,
  "installCommand": "true",
  "buildCommand": "v=$(find public -maxdepth 1 -type f \\( -name '*.js' -o -name '*.html' \\) | sort | xargs cat | sha1sum | cut -c1-16); c=$({ find public -maxdepth 1 -type f -name '*.css'; find public/themes -type f -name '*.css' 2>/dev/null; } | sort | xargs cat | sha1sum | cut -c1-16); printf '{\"v\":\"%s\",\"c\":\"%s\"}\\n' \"$v\" \"$c\" > public/version.json",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:slug([a-z0-9][a-z0-9-]*)",
      "destination": "/api/ingresso?s=:slug"
    },
    {
      "source": "/:slug([a-z0-9][a-z0-9-]*)/:p([a-z0-9]{1,12})",
      "destination": "/api/ingresso?s=:slug"
    }
  ],
  "functions": {
    "api/ingresso.js": {
      "includeFiles": "public/index.html"
    }
  }
}
